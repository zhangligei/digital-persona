# Copy this file to .env and fill in real values. .env is gitignored;
# this file is the template and should stay free of real secrets.

# Placeholder — Postgres connection string for Prisma. Replace with your
# actual database URL (local, Docker, or a hosted provider).
DATABASE_URL="postgresql://user:password@localhost:5432/echo?schema=public"

# Placeholder — random secret used to sign/encrypt user sessions once a
# session strategy is wired up in lib/auth.ts. Generate one with, e.g.,
# `openssl rand -base64 32`.
SESSION_SECRET="replace-with-a-random-secret"

# Server-only SMTP credentials used to send registration confirmation emails
# (lib/email.ts, via nodemailer). Keep these out of NEXT_PUBLIC_* variables.
# SMTP_PORT 465 is implicit TLS; 587 would need STARTTLS instead (see
# lib/email.ts's `secure` check if you switch ports).
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="replace-with-your-smtp-username"
SMTP_PASSWORD="replace-with-your-smtp-password"
EMAIL_FROM="ECHO 回响 <customerservice@echodigitalpersona.com>"

# Placeholder — secret key for whichever payment provider (e.g. Stripe)
# powers Subscription billing in lib/payment.ts. Not wired up yet.
PAYMENT_PROVIDER_SECRET_KEY="replace-with-your-payment-provider-secret-key"

# Placeholder — publishable/public key for the same payment provider, safe to
# expose client-side once billing UI is built. Not wired up yet.
PAYMENT_PROVIDER_PUBLIC_KEY="replace-with-your-payment-provider-public-key"

# Supabase project URL and service_role key, used by lib/storage.ts to
# upload persona media (photos, video, audio, facial scans) to Supabase
# Storage. The service_role key bypasses Row Level Security — server-side
# only, never expose via NEXT_PUBLIC_*.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="replace-with-your-storage-bucket-name"

# Real-time avatar streaming via the standalone LiveTalking WebRTC server
# (back_end/services/livetalking.ts, back_end/api/personas/[id]/live-session).
# LIVETALKING_SERVER_URL is the base URL the *browser* connects to directly —
# it must be publicly reachable (LiveTalking's own port, not proxied through
# this app). LIVETALKING_SESSION_SECRET must be the exact same value as the
# LIVETALKING_SESSION_SECRET set in that server's own .env, since both sides
# sign/verify the same HMAC session token. Generate with `openssl rand -hex 32`.
LIVETALKING_SERVER_URL="http://your-livetalking-server:8010"
LIVETALKING_SESSION_SECRET="replace-with-a-random-secret-shared-with-the-livetalking-server"

# Optional TURN relay for the browser's own RTCPeerConnection (used by
# back_end/services/livetalking.ts turnServerConfig()). Only needed when the
# LiveTalking server itself sits behind a NAT/firewall that can't be reached
# directly — the LiveTalking server has the same three vars set in its own
# environment (see start-livetalking.sh) so it can request a relay candidate
# on the same TURN server. Comma-separated if the TURN server has multiple
# URLs (e.g. distinct UDP/TCP ports).
TURN_SERVER_URL="turn:your-turn-server:3478?transport=udp"
TURN_USERNAME="replace-with-turn-username"
TURN_CREDENTIAL="replace-with-turn-credential"

# Server-only LLM credentials for retrieval-grounded persona replies. In the
# deployed Cloudflare Worker, set OPENAI_API_KEY with `wrangler secret put`;
# never prefix it with NEXT_PUBLIC_ or commit a real value. OPENAI_MODEL is
# optional and lets an operator override the low-latency default.
OPENAI_API_KEY="replace-with-your-llm-api-key"
OPENAI_MODEL="gpt-4.1-mini"

# Anime latency demo. The key stays server-side; /api/demo/tts streams the
# provider audio to the browser. The demo labels browser speech as a fallback
# when the key is absent or the provider request fails.
ECHO_DEMO_ENABLED="true"
ECHO_DEMO_TTS_ENABLED="true"
ECHO_TTS_MODEL="gpt-4o-mini-tts"
ECHO_TTS_VOICE="coral"
