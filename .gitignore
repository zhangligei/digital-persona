# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars

# vercel
.vercel

# Local agent/editor state and third-party reference checkout. They are not
# part of the ECHO application source and must not become nested repositories
# or carry local runtime credentials into this repository.
/.agents/
/.claude/
/.wrangler/
/awesome-design-md/
# Local research/export material is not application source. Keep it out of
# release commits unless it is deliberately moved into docs/.
/output/

# Locally recorded demo videos and frame previews.
/demo-output/

# Separate research material — never part of the ECHO application, deployment,
# or source repository.
ai_resurrection_hir_reference.md
ai-resurrection-hir-reference.md

# typescript
*.tsbuildinfo
next-env.d.ts
cloudflare-env.d.ts

# prisma generated client
/generated/prisma
